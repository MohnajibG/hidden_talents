PORT=3000

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/hidden-talents

# Secret used to sign sessions: a long random string (32 characters or more)
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Optional: only accept email addresses on this domain (without @). Empty = any address.
ALLOWED_EMAIL_DOMAIN=

# Addresses that get the admin RH role at registration, comma-separated.
RH_EMAILS=first.last@example.com

# Exact URL of the deployed Frontend (CORS + cross-origin cookie). Not needed locally.
FRONTEND_URL=https://my-app.vercel.app

# Set to "production" once deployed (enables Secure + SameSite=None on the session cookie).
NODE_ENV=
