PORT=3000

# Chaîne de connexion MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/talents-caches

# Secret pour signer les sessions : une longue chaîne aléatoire (32 caractères ou plus)
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire

# Facultatif : n'accepter que les adresses de ce domaine (sans @). Vide = toutes les adresses.
ALLOWED_EMAIL_DOMAIN=

# Adresses qui reçoivent le rôle RH à l'inscription, séparées par des virgules.
# C'est ensuite depuis l'espace RH que l'on attribue les rôles manager et direction.
RH_EMAILS=prenom.nom@exemple.com

# URL exacte du Frontend déployé (CORS + cookie cross-origin). Pas besoin en local.
FRONTEND_URL=https://mon-app.vercel.app

# Mettre à "production" une fois déployé (active Secure + SameSite=None sur le cookie de session).
NODE_ENV=
