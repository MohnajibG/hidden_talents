PORT=3000

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/hidden-talents

# Secret used to sign sessions: a long random string (32 characters or more)
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Okta OIDC app (Web Application, Authorization Code + PKCE).
# Issuer: Okta domain + /oauth2/default (or a custom authorization server).
OKTA_ISSUER=https://your-domain.okta.com/oauth2/default
OKTA_CLIENT_ID=replace-with-your-client-id
OKTA_CLIENT_SECRET=replace-with-your-client-secret
# Must exactly match the "Sign-in redirect URI" configured on the Okta app.
OKTA_REDIRECT_URI=http://localhost:3000/api/auth/okta/callback

# Optional: only accept email addresses on this domain (without @). Empty = any address.
ALLOWED_EMAIL_DOMAIN=

# Addresses that get the admin RH role on first login, comma-separated.
RH_EMAILS=first.last@example.com

# Exact URL of the deployed Frontend (CORS, cross-origin cookie, post-login redirect).
# Defaults to http://localhost:5173 locally.
FRONTEND_URL=https://my-app.vercel.app

# Set to "production" once deployed (enables Secure + SameSite=None on the session cookie).
NODE_ENV=
